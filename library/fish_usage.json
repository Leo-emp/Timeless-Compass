      "reference_id": "f8dfe9c83081432386f143e2fe9767ef",
      "model": "s2.1-pro-free",
      "bytes": 43,
      "text": "My men have become women, and my women men.",
      "file": "line_000_xerxes_2da22966.mp3",
      "cached": false
    },
    {
      "date": "2026-11-21T07:15:32",
      "job": "plan3-voicetest",
      "speaker": "LEONIDAS",
      "voice": "leonidas",
      "reference_id": "d1ac8678a66a43eba8c2c2a3a6d9a689",
      "model": "s2.1-pro-free",
      "bytes": 19,
      "text": "Come and take them.",
      "file": "film\\out\\voicetest\\leonidas.mp3",
      "cached": false
    },
    {
      "date": "2026-11-21T07:15:38",
      "job": "plan3-voicetest",
      "speaker": "THEMISTOCLES",
      "voice": "themistocles",
      "reference_id": "cf270b96152440379e8cb6a42f6c7997",
      "model": "s2.1-pro-free",
      "bytes": 59,
      "text": "Fight here, in the narrows, and their numbers mean nothing.",
      "file": "film\\out\\voicetest\\themistocles.mp3",
      "cached": false
    },
    {
      "date": "2026-11-21T07:57:03",
      "job": "20261121-0752-the-trap-at-salamis-proof",
      "line": 2,
      "speaker": "XERXES",
      "voice": "xerxes",
      "reference_id": "f8dfe9c83081432386f143e2fe9767ef",
      "model": "s2.1-pro-free",
      "bytes": 19,
      "text": "Today, Greece ends.",
      "file": "line_002_xerxes_6059e69a.mp3",
      "cached": false
    },
    {
      "date": "2026-11-21T07:57:11",
      "job": "20261121-0752-the-trap-at-salamis-proof",
      "line": 6,
      "speaker": "THEMISTOCLES",
      "voice": "themistocles",
      "reference_id": "cf270b96152440379e8cb6a42f6c7997",
      "model": "s2.1-pro-free",
      "bytes": 58,
      "text": "Tell the king the Greeks will run. Tell him to strike now.",
      "file": "line_006_themistocles_2a77c91b.mp3",
      "cached": false
    },
    {
      "date": "2026-11-21T09:24:01",
      "job": "20261121-0919-come-and-take-them-thermopylae",
      "line": 1,
      "speaker": "XERXES",
      "voice": "xerxes",
      "reference_id": "f8dfe9c83081432386f143e2fe9767ef",
      "model": "s2.1-pro-free",
      "bytes": 40,
      "text": "Lay down your weapons, and you may live.",
      "file": "line_001_xerxes_990df5e2.mp3",
      "cached": false
    },
    {
      "date": "2026-11-21T09:24:08",
      "job": "20261121-0919-come-and-take-them-thermopylae",
